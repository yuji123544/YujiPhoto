--!strict
-- YujiFlipbook: plays white-layer flipbook VFX built with YujiPhoto (yuji-vfx).
-- Put this ModuleScript in ReplicatedStorage and require it from a LocalScript
-- (VFX belong on the client).
--
-- An effect is a table generated by `yuji-vfx luau <name>.vfx.json`:
--   { name, grid, size, frames, fps, layers = { { name, image, color, lightEmission, brightness }, ... } }
-- Layers are WHITE textures, listed bottom first; each one is tinted at runtime, so one
-- drawing gives every element (ice, fire, poison, void...).
--
-- Two ways to show it:
--   YujiFlipbook.burst(attachmentOrPart, effect, opts)   ParticleEmitters (camera-facing, additive glow)
--   YujiFlipbook.plane(cframe, size, effect, opts)       a flat plate in the world (slashes on the swing plane)

local RunService = game:GetService("RunService")

local YujiFlipbook = {}

export type Layer = {
	name: string,
	image: string,
	color: Color3?,
	lightEmission: number?,
	brightness: number?,
}

export type Effect = {
	name: string,
	grid: number,
	size: number,
	frames: number,
	fps: number,
	layers: { Layer },
}

export type Options = {
	palette: any?, -- a name from YujiFlipbook.Palettes, or { [layerName]: Color3 }
	colors: { [string]: Color3 }?, -- per-layer override by layer name
	fps: number?,
	scale: number?, -- particle size in studs (burst)
	rotation: number?, -- degrees (burst)
	loop: boolean?, -- plane only
	doubleSided: boolean?, -- plane only, default true
	transparency: number?, -- 0..1 extra fade for every layer
}

-- Same palettes as the previews in yuji-vfx (src/lib/preview.mjs). Keys match layer names.
YujiFlipbook.Palettes = {
	ice = { glow = Color3.fromHex("2f7bff"), body = Color3.fromHex("6fc3ff"), core = Color3.fromHex("e8fbff"), rim = Color3.fromHex("b8ecff") },
	fire = { glow = Color3.fromHex("ff3a00"), body = Color3.fromHex("ff8a1c"), core = Color3.fromHex("fff1b0"), rim = Color3.fromHex("ffc24a") },
	poison = { glow = Color3.fromHex("18a83a"), body = Color3.fromHex("5fe04a"), core = Color3.fromHex("eaffc0"), rim = Color3.fromHex("a6ff6a") },
	void = { glow = Color3.fromHex("5a12c8"), body = Color3.fromHex("9a4dff"), core = Color3.fromHex("f2e6ff"), rim = Color3.fromHex("d29bff") },
	holy = { glow = Color3.fromHex("ffb800"), body = Color3.fromHex("ffe066"), core = Color3.fromHex("ffffff"), rim = Color3.fromHex("fff4c2") },
	storm = { glow = Color3.fromHex("1f6dff"), body = Color3.fromHex("7fd8ff"), core = Color3.fromHex("ffffff"), rim = Color3.fromHex("e0f6ff") },
}

local LAYOUTS = {
	[2] = Enum.ParticleFlipbookLayout.Grid2x2,
	[4] = Enum.ParticleFlipbookLayout.Grid4x4,
	[8] = Enum.ParticleFlipbookLayout.Grid8x8,
}

local function paletteColor(palette: any, layerName: string): Color3?
	if palette == nil then
		return nil
	end
	local p = if typeof(palette) == "string" then YujiFlipbook.Palettes[palette] else palette
	if p == nil then
		return nil
	end
	if p[layerName] then
		return p[layerName]
	end
	local lower = string.lower(layerName)
	for key, color in p do
		if string.find(lower, key, 1, true) then
			return color
		end
	end
	return nil
end

local function colorFor(layer: Layer, opts: Options?): Color3
	local o = opts or {}
	return (o.colors and o.colors[layer.name]) or paletteColor(o.palette, layer.name) or layer.color or Color3.new(1, 1, 1)
end

--[[ Particle version: one ParticleEmitter per layer, stacked with ZOffset, playing the
flipbook once (OneShot) over the particle's lifetime. Returns the emitters; call
:Emit(1) on each, or use the returned emit() function. ]]
function YujiFlipbook.burst(parent: Instance, effect: Effect, opts: Options?): ({ ParticleEmitter }, () -> ())
	local o = opts or {}
	local fps = o.fps or effect.fps
	local lifetime = effect.frames / fps
	local emitters = {}
	for i, layer in effect.layers do
		local e = Instance.new("ParticleEmitter")
		e.Name = `{effect.name}_{layer.name}`
		e.Texture = layer.image
		e.FlipbookLayout = LAYOUTS[effect.grid] or Enum.ParticleFlipbookLayout.Grid4x4
		e.FlipbookMode = Enum.ParticleFlipbookMode.OneShot
		e.FlipbookFramerate = NumberRange.new(fps)
		e.Lifetime = NumberRange.new(lifetime)
		e.Rate = 0
		e.Speed = NumberRange.new(0)
		e.LockedToPart = true
		e.LightInfluence = 0
		e.LightEmission = layer.lightEmission or 1
		e.Brightness = layer.brightness or 1
		e.Color = ColorSequence.new(colorFor(layer, o))
		e.Size = NumberSequence.new(o.scale or 6)
		e.Rotation = NumberRange.new(o.rotation or 0)
		e.Transparency = NumberSequence.new(o.transparency or 0)
		e.ZOffset = (i - 1) * 0.02 -- later layers draw on top
		e.Parent = parent
		table.insert(emitters, e)
	end
	local function emit()
		for _, e in emitters do
			e:Emit(1)
		end
	end
	return emitters, emit
end

--[[ Plane version: an invisible plate whose top face shows every layer as an ImageLabel,
stepping ImageRectOffset through the grid. The plate's UpVector is the plane normal, so
for a slash pass a CFrame lying in the swing plane. Destroys itself at the end unless loop. ]]
function YujiFlipbook.plane(cframe: CFrame, size: Vector2, effect: Effect, opts: Options?): { part: BasePart, stop: () -> () }
	local o = opts or {}
	local fps = o.fps or effect.fps
	local cell = effect.size // effect.grid

	local part = Instance.new("Part")
	part.Name = `{effect.name}_VFX`
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(size.X, 0.05, size.Y)
	part.CFrame = cframe

	local labels: { ImageLabel } = {}
	local faces = if o.doubleSided == false then { Enum.NormalId.Top } else { Enum.NormalId.Top, Enum.NormalId.Bottom }
	for _, face in faces do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.LightInfluence = 0
		gui.Brightness = 2
		gui.CanvasSize = Vector2.new(cell, cell)
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui.Parent = part
		for i, layer in effect.layers do
			local img = Instance.new("ImageLabel")
			img.Name = layer.name
			img.BackgroundTransparency = 1
			img.Size = UDim2.fromScale(1, 1)
			img.Image = layer.image
			img.ImageColor3 = colorFor(layer, o)
			img.ImageTransparency = o.transparency or 0
			img.ImageRectSize = Vector2.new(cell, cell)
			img.ImageRectOffset = Vector2.zero
			img.ZIndex = i
			img.Parent = gui
			table.insert(labels, img)
		end
	end
	part.Parent = workspace

	local start = os.clock()
	local conn: RBXScriptConnection
	local function stop()
		if conn then
			conn:Disconnect()
		end
		part:Destroy()
	end
	conn = RunService.Heartbeat:Connect(function()
		local f = math.floor((os.clock() - start) * fps)
		if f >= effect.frames then
			if o.loop then
				start = os.clock()
				f = 0
			else
				stop()
				return
			end
		end
		local offset = Vector2.new((f % effect.grid) * cell, (f // effect.grid) * cell)
		for _, img in labels do
			img.ImageRectOffset = offset
		end
	end)
	return { part = part, stop = stop }
end

return YujiFlipbook
